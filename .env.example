# Copy to .env and adjust. All values have sane defaults; nothing here is required.

# --- LLM (Ollama) ---
GENVAI_LLM__BASE_URL=http://localhost:11434
GENVAI_LLM__MODEL=qwen2.5:7b-instruct
GENVAI_LLM__TIMEOUT_S=120

# --- Image generation ---
# Providers: diffusers | procedural | null
GENVAI_IMAGE__PROVIDER=procedural
GENVAI_IMAGE__MODEL=stabilityai/sd-turbo
GENVAI_IMAGE__DEVICE=cuda
GENVAI_IMAGE__LOW_VRAM=true

# --- Speech ---
GENVAI_TTS__PROVIDER=null
GENVAI_TTS__VOICE=en_US-amy-medium

# --- Music ---
# Nothing is ever downloaded without explicit confirmation.
GENVAI_MUSIC__PROVIDER=local
GENVAI_MUSIC__LIBRARY_DIR=assets/music_cache
GENVAI_MUSIC__ALLOW_DOWNLOAD=false

# --- Paths ---
GENVAI_PROJECTS_DIR=projects
